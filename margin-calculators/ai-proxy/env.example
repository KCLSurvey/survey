# Copy this file to .env. Choose ONE provider.
AI_PROVIDER=openrouter
AI_MODEL=~openai/gpt-latest

# Fill only the key for the selected provider:
OPENROUTER_API_KEY=replace_with_your_openrouter_key
OPENAI_API_KEY=

PORT=3000
ALLOWED_ORIGIN=https://kclsurvey.github.io,http://localhost:3000,http://127.0.0.1:3000
MAX_BODY_BYTES=2000000
MAX_REQUESTS_PER_MINUTE=30
